---
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import { site } from '@/data/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = site.description,
  image = '/og.png',
  type = 'website',
} = Astro.props;

// `build.format: 'file'` makes Astro.url.pathname end in `.html` at build
// time (e.g. `/about.html`), but Cloudflare Pages serves the extensionless
// URL and redirects `*.html` to it. Strip the extension so canonical/og:url
// match the live URLs and the sitemap. The root file is `/index.html`,
// whose public canonical is `/` rather than the redirecting `/index`.
const extensionlessPath = Astro.url.pathname.replace(/\.html$/, '') || '/';
const canonicalPath = extensionlessPath === '/index' ? '/' : extensionlessPath;
const canonical = new URL(canonicalPath, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const isHome = canonicalPath === '/';
const fullTitle = isHome
  ? `${site.name} — ${site.role}`
  : `${title} · ${site.name}`;
const personNode = {
  '@type': 'Person',
  '@id': site.personId,
  name: site.name,
  alternateName: site.alternateNames,
  jobTitle: site.role,
  description: site.description,
  url: site.url,
  image: site.image,
  email: `mailto:${site.email}`,
  sameAs: Object.values(site.profiles),
};
const structuredDataGraph: Record<string, unknown>[] = [personNode];

if (isHome) {
  structuredDataGraph.unshift({
    '@type': 'ProfilePage',
    '@id': `${site.url}/#profile-page`,
    url: site.url,
    name: `${site.name} — ${site.role}`,
    mainEntity: { '@id': site.personId },
  });
}
---

<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content={Astro.generator}>

<title>{fullTitle}</title>
<meta name="description" content={description}>
<meta name="author" content={site.name}>
<link rel="canonical" href={canonical}>

<link rel="icon" type="image/svg+xml" href="/favicon.svg">

<!-- Preload only the LCP font; let Vite resolve its current asset URL. -->
<link rel="preload" as="font" type="font/woff2" href={geistLatin} crossorigin>
<link rel="sitemap" href="/sitemap-index.xml">
<meta name="theme-color" content="#08090a">

<!-- Open Graph -->
<meta property="og:type" content={type}>
<meta property="og:site_name" content={site.name}>
<meta property="og:title" content={fullTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={fullTitle}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
<meta name="twitter:creator" content="@sarthakcodes">

<!-- One stable identity graph prevents this person from being conflated with namesakes. -->
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': structuredDataGraph,
  })}
/>
