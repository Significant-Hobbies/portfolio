---
import { ClientRouter } from 'astro:transitions';
import Clarity from '@/components/astro/Clarity.astro';
import { site } from '@/data/site';
---

<meta name="generator" content={Astro.generator}>
<meta name="author" content={site.name}>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<!-- Discover the cover before layout. Match the mobile CSS override without
     also preloading the desktop image. -->
<link
  rel="preload"
  as="image"
  type="image/webp"
  href="/images/personal-workbench-mobile.webp"
  media="(max-width: 640px)"
  fetchpriority="high"
>
<link
  rel="preload"
  as="image"
  type="image/webp"
  href="/images/personal-workbench.webp"
  media="(width > 640px)"
  fetchpriority="high"
>
<link rel="sitemap" href="/sitemap-index.xml">
<link rel="alternate" type="text/markdown" href="/index.md">
<meta name="theme-color" content="#08090a">
<meta property="og:image:type" content="image/png">
<meta name="twitter:creator" content="@sarthakcodes">
<script is:inline>
  (() => {
    const apply = () => {
      let theme = 'dark';
      try {
        if (localStorage.getItem('sarthak-theme') === 'light') theme = 'light';
      } catch {}
      document.documentElement.dataset.theme = theme;
      document.documentElement.style.colorScheme = theme;
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute('content', theme === 'light' ? '#f7f9fc' : '#08090a');
      document.querySelectorAll('fleet-footer-extension').forEach((footer) => {
        footer.setAttribute('theme', theme);
      });
    };
    apply();
    document.addEventListener('astro:page-load', apply);
    document.addEventListener('footer-connect', apply);
  })();
</script>
<ClientRouter />
<Clarity />
