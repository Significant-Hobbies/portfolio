---
import { navLinks, site } from '@/data/site';
import { socials } from '@/data/socials';

const year = new Date().getFullYear();
const profiles = socials.filter((social) => social.label !== 'Email');
const repoUrl = 'https://github.com/sarthakagrawal927/portfolio';
---

<footer id="contact" class="precise-footer scroll-mt-20">
  <fleet-footer-extension
    data-fleet-footer-project="sarthakagrawal-personal"
    product-name={site.name}
    signature-name={site.name}
    fonts="false"
    theme="dark"
    surface="landing"
    art-src="/fleet-footer/art/sarthakagrawal-personal.webp"
    art-width="2171"
    art-height="724"
    art-position="50% 50%"
    art-alt="An original engineering workbench illustration for Sarthak Agrawal’s personal portfolio."
    art-credit="Original illustration for Sarthak Agrawal"
  >
    <div slot="cta" class="precise-contact" data-fleet-footer-cta>
      <p class="precise-label">Contact</p>
      <p class="precise-pilot">
        I'm available for a $500 USD feature verification pilot: AI agents
        inspect one agreed TypeScript/Node workflow, run reproducible checks,
        and write the report. I am the contact for scope and payment. $250 to
        start, $250 on delivery; three working days after scope and runnable
        setup are agreed. Fixes are separately scoped.
      </p>
      <!--email_off-->
      <a
        href={`mailto:${site.email}?subject=${encodeURIComponent('$500 feature verification pilot')}`}
        class="precise-email"
      >
        {site.email}
      </a>
      <!--/email_off-->
    </div>

    <div
      slot="navigation"
      class="precise-navigation"
      data-fleet-footer-navigation
    >
      <nav class="precise-groups" aria-label="Portfolio resources">
        <div>
          <h2 data-fleet-footer-group-label>Explore</h2>
          {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
        <div>
          <h2 data-fleet-footer-group-label>Résumé</h2>
          <a href={site.resumeUrl}>Read résumé</a>
          <a href={site.resumePdf}>Download PDF</a>
          <a href={repoUrl} target="_blank" rel="noopener noreferrer"
            >Site source</a
          >
        </div>
        <div>
          <h2 data-fleet-footer-group-label>Connect</h2>
          {profiles.map((social) => (
            <a href={social.href} target="_blank" rel="noopener noreferrer">
              {social.label}
            </a>
          ))}
        </div>
      </nav>
      <p class="precise-legal" data-fleet-footer-legal>© {year} {site.name}</p>
    </div>
  </fleet-footer-extension>
</footer>

<style>
  .precise-footer {
    color: var(--color-fg);
  }
  fleet-footer-extension {
    --fleet-footer-ui-font: var(--font-sans);
    --fleet-footer-mono-font: var(--font-mono);
    --fleet-footer-label-font: var(--font-mono);
    --fleet-footer-signature-font: var(--font-sans);
    --fleet-footer-canvas: var(--color-base);
    --fleet-footer-lower: var(--color-panel-2);
    --fleet-footer-border: var(--color-line-strong);
    --fleet-footer-focus: var(--color-accent);
    --fleet-footer-max-width: 72rem;
    --fleet-footer-signature-size: clamp(2.25rem, 7.6vw, 6.8rem);
    --fleet-footer-mobile-signature-size: clamp(1.85rem, 8.2vw, 3.5rem);
  }
  fleet-footer-extension::part(wordmark) {
    white-space: nowrap;
  }
  .precise-contact,
  .precise-navigation {
    min-width: 0;
    font-family: var(--font-sans);
  }
  .precise-label,
  .precise-groups h2 {
    margin: 0 0 0.75rem;
    color: var(--color-muted);
    font: 400 0.75rem / 1.5 var(--font-mono);
    letter-spacing: 0;
  }
  .precise-pilot {
    max-width: 34rem;
    margin: 0 0 0.5rem;
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .precise-email {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    max-width: 100%;
    overflow-wrap: anywhere;
    color: var(--color-fg);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .precise-groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .precise-groups > div {
    min-width: 0;
  }
  .precise-groups a {
    display: flex;
    align-items: center;
    min-height: 44px;
    width: fit-content;
    max-width: 100%;
    color: var(--color-fg);
    font-size: 0.875rem;
    line-height: 1.5;
    text-decoration: none;
  }
  .precise-groups a:hover,
  .precise-email:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .precise-groups a:focus-visible,
  .precise-email:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  .precise-legal {
    margin: 1.5rem 0 0;
    color: var(--color-faint);
    font-size: 0.75rem;
  }
  fleet-footer-extension:not(:defined) {
    display: block;
    max-width: 72rem;
    margin-inline: auto;
    padding: 2rem 1.25rem;
    border-top: 1px solid var(--color-line);
  }
  fleet-footer-extension:not(:defined) .precise-navigation {
    margin-top: 1.5rem;
  }
  @media (max-width: 640px) {
    .precise-groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem 1rem;
    }
  }
</style>
