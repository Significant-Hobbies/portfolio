---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/data/site';
import {
  getResume,
  resumeTrackMeta,
  resumeTracks,
  type ResumeTrack,
} from '@/data/resume';

// Shared view for the three résumé tracks. The PDF behind the download
// button is generated at build time from the same data (src/lib/resume-pdf.ts).

interface Props {
  track: ResumeTrack;
}

const { track } = Astro.props;
const resume = getResume(track);

const contacts = [
  { label: 'Email', value: site.email, href: `mailto:${site.email}` },
  {
    label: 'GitHub',
    value: site.githubUser,
    href: site.profiles.github,
  },
  {
    label: 'LinkedIn',
    value: site.githubUser,
    href: site.profiles.linkedin,
  },
];
---

<BaseLayout
  title={track === 'ai-infra' ? 'Résumé' : `Résumé — ${resume.headline}`}
  description={`Résumé of ${site.name} — ${resume.headline}.`}
>
  <section class="mx-auto max-w-3xl px-5 py-16 sm:px-8 sm:py-20">
    <!-- Header -->
    <header class="border-b border-line pb-8">
      <div
        class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between"
      >
        <div>
          <p class="kicker">// résumé</p>
          <h1
            class="mt-3 text-3xl font-semibold tracking-tight text-fg sm:text-4xl"
          >
            {site.name}
          </h1>
          <p class="mt-1 font-mono text-sm text-accent">{resume.headline}</p>

          <!--email_off-->
          <div class="mt-4 flex flex-wrap gap-x-5 gap-y-1.5">
            {contacts.map((c) => (
                <a
                  href={c.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-mono text-xs text-muted transition-colors hover:text-accent"
                >
                  {c.label}: <span class="text-faint">{c.value}</span>
                </a>
              ))}
          </div>
          <!--/email_off-->
        </div>

        <a
          href={resume.pdfPath}
          download={resume.pdfFileName}
          class="shrink-0 self-start rounded-md bg-accent px-4 py-2.5 text-sm font-medium text-base transition-opacity hover:opacity-90 sm:self-auto"
        >
          ↓ Download PDF
        </a>
      </div>

      <nav aria-label="Résumé versions" class="mt-6 flex flex-wrap gap-2">
        {resumeTracks.map((t) => (
          <a
            href={resumeTrackMeta[t].path}
            aria-current={t === track ? 'page' : undefined}
            class:list={[
              'rounded-md border px-3 py-1.5 font-mono text-xs transition-colors',
              t === track
                ? 'border-accent text-accent'
                : 'border-line text-muted hover:text-accent',
            ]}
          >
            {resumeTrackMeta[t].label}
          </a>
        ))}
      </nav>

      <p class="mt-6 text-sm leading-relaxed text-muted">{resume.summary}</p>
    </header>

    <!-- Experience -->
    <div class="mt-10">
      <h2 class="kicker">// experience</h2>
      <div class="mt-5 space-y-8">
        {resume.experience.map((job) => (
            <div>
              <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                <h3 class="font-semibold text-fg">
                  {job.role}
                  <span class="text-muted"> · </span>
                  <span class="text-accent">{job.company}</span>
                  <span class="ml-2 inline-block rounded border border-line bg-panel-2 px-1.5 py-0.5 align-middle font-mono text-[10px] font-normal text-faint">
                    {job.note}
                  </span>
                </h3>
                <span class="font-mono text-xs text-faint">{job.period}</span>
              </div>
              {job.context && (
                <p class="mt-1 text-xs text-faint">{job.context}</p>
              )}
              <ul class="mt-3 space-y-2">
                {job.bullets.map((b) => (
                  <li class="flex gap-2.5 text-sm leading-relaxed text-muted">
                    <span class="mt-2 h-px w-2.5 shrink-0 bg-accent" />
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
      </div>
    </div>

    <!-- Projects -->
    <div class="mt-12">
      <h2 class="kicker">// selected projects</h2>
      <div class="mt-5 space-y-6">
        {resume.projects.map((p) => (
            <div>
              <h3 class="text-sm font-semibold text-fg">
                {p.href ? (
                  <a
                    href={p.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-underline"
                  >
                    {p.name}
                  </a>
                ) : (
                  p.name
                )}
                <span class="font-normal text-muted"> — {p.tagline}</span>
              </h3>
              <p class="mt-0.5 font-mono text-[11px] text-faint">{p.stack}</p>
              <ul class="mt-2 space-y-1.5">
                {p.bullets.map((b) => (
                  <li class="flex gap-2.5 text-sm leading-relaxed text-muted">
                    <span class="mt-2 h-px w-2.5 shrink-0 bg-accent" />
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
      </div>
      <a
        href="/projects"
        class="link-underline mt-4 inline-block font-mono text-xs text-accent"
      >
        More on the projects page →
      </a>
    </div>

    <!-- Skills -->
    <div class="mt-12">
      <h2 class="kicker">// skills</h2>
      <dl class="mt-5 space-y-3">
        {resume.skills.map((s) => (
            <div class="grid gap-1 sm:grid-cols-[180px_1fr]">
              <dt class="font-mono text-xs text-faint">{s.label}</dt>
              <dd class="text-sm text-muted">{s.items}</dd>
            </div>
          ))}
      </dl>
    </div>

    <!-- Education -->
    <div class="mt-12">
      <h2 class="kicker">// education</h2>
      <div class="mt-5 flex flex-wrap items-baseline justify-between gap-x-3">
        <h3 class="font-semibold text-fg">{resume.education.school}</h3>
        <span class="font-mono text-xs text-faint">
          {resume.education.period}
        </span>
      </div>
      <p class="mt-1 text-sm text-accent">{resume.education.degree}</p>
      <p class="mt-2 text-sm leading-relaxed text-muted">
        {resume.education.detail}
      </p>
    </div>
  </section>
</BaseLayout>
