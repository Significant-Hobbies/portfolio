---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { privacy } from '@/data/privacy';
import { site } from '@/data/site';
---

<BaseLayout
  title="Privacy"
  description={`Privacy policy for ${site.url} — personal portfolio and writing by ${site.name}.`}
>
  <article class="mx-auto max-w-2xl px-5 py-16 sm:px-8 sm:py-20">
    <a
      href="/"
      class="link-underline font-mono text-sm text-muted transition-colors hover:text-accent"
    >
      ← home
    </a>

    <header class="mt-8 border-b border-line pb-8">
      <h1 class="text-3xl font-semibold tracking-tight text-fg sm:text-4xl">
        Privacy Policy
      </h1>
      <p class="mt-3 font-mono text-xs text-faint">
        Last updated: {privacy.displayedDate}
      </p>
    </header>

    <div class="prose mt-8">
      <h2>What this site is</h2>
      <p>{privacy.introduction}</p>

      <h2>What may be collected</h2>
      <ul>
        {privacy.collections.map((item) => (
          <li><strong>{item.label}</strong> {item.text}</li>
        ))}
      </ul>

      <h2>Contact</h2>
      <p>
        Questions: <!--email_off--><a href={`mailto:${site.email}`}
          >{site.email}</a
        ><!--/email_off-->
      </p>
    </div>
  </article>
</BaseLayout>
